{
  "name": "@agentlint/cli",
  "version": "0.1.0",
  "description": "Local-first CLI tool for continuous improvement of AI-assisted development workflows",
  "type": "module",
  "main": "dist/cli.js",
  "types": "src/types/index.ts",
  "bin": {
    "agentlint": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "src",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Obsidian-Owl/agentlint.git"
  },
  "author": "Obsidian Owl",
  "keywords": [
    "ai",
    "cli",
    "development",
    "workflow",
    "linter",
    "agent"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist",
    "build:binary": "bun build src/cli.ts --compile --minify --outfile dist/agentlint",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
